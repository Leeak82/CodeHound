# Optional. Screenshot reading and verbatim LLM extraction use this.
# A Gemini Flash model. Override GEMINI_MODEL if your key uses a newer Flash id.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional web-search providers. The app works with none of these.
# Free search is Bing HTML, then DuckDuckGo HTML, Startpage, and Mojeek.
BRAVE_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=

# Optional shared vote + cache storage. Without these, data stays in DATA_DIR
# (ephemeral on Render). See README for the SQL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cache lifetime per brand. Clamped to 1–3 hours.
CACHE_TTL_SECONDS=7200

PORT=3000
DATA_DIR=./data

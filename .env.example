# Optional. Screenshot reading and verbatim LLM extraction use this.
# A Gemini Flash model. Override GEMINI_MODEL if your key uses a newer Flash id.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional web-search providers. The app works with none of these.
# Free search is Bing HTML, then DuckDuckGo HTML, Startpage, and Mojeek.
BRAVE_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=

# Optional shared vote + cache storage. Without these, data stays in DATA_DIR
# (ephemeral on Render). See README for the SQL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cache lifetime per brand. Clamped to 1–3 hours.
CACHE_TTL_SECONDS=7200

# Public site URL used in unsubscribe links. Render sets the host if this is blank.
PUBLIC_BASE_URL=

# Shared secret for the daily GitHub Action. Send it as the x-cron-secret header.
CRON_SECRET=

# Email alerts. Use Resend, or SMTP (Gmail app password works on port 465).
# Leave these blank and the Watch form explains that email alerts are not on yet.
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional ntfy server. Blank means https://ntfy.sh. Topics come from the user.
NTFY_SERVER=

PORT=3000
DATA_DIR=./data
